/// @notice Receipt-chained NB2 v1.1 verifier with a fixed generation and dependency graph.
abstract contract ERC20RecoveryBinding is ERC20FlatRecovery {
    ERC20BridgeVerifier public immutable ORDINARY;
    bytes32 public immutable ORDINARY_HASH;
    bytes32 public immutable REGISTRY_HASH;
    bytes32 public immutable LINEAGE_HASH;
    bytes32 public immutable RECEIPTS_HASH;
    bytes32 public immutable PINS;
    bytes32 public immutable GENERATION;

    constructor(
        bytes memory gamma,
        ERC20BridgeVerifier ordinary,
        bytes32 salt,
        FlatBindings.ReleaseInputs memory release,
        bytes32 expectedPins
    )
        ERC20FlatRecovery(
            ordinary.readConfig(gamma),
            ordinary.readChainId(gamma),
            ordinary.LINEAGE(),
            ordinary.RECEIPTS()
        )
    {
        ORDINARY = ordinary;
        ORDINARY_HASH = address(ordinary).codehash;
        REGISTRY_HASH = ordinary.REGISTRY_HASH();
        LINEAGE_HASH = ordinary.LINEAGE_HASH();
        RECEIPTS_HASH = ordinary.RECEIPTS_HASH();
        PINS = FlatBindings.pins(
            release,
            address(ordinary),
            ORDINARY_HASH,
            address(RECEIPTS),
            RECEIPTS_HASH,
            REGISTRY_HASH,
            address(LINEAGE),
            LINEAGE_HASH
        );
        if (
            PINS != expectedPins || salt == 0 || VAULT == address(this)
                || VAULT == address(ordinary) || address(LINEAGE).codehash != LINEAGE_HASH
                || address(RECEIPTS).codehash != RECEIPTS_HASH
                || FlatNative.REGISTRY.codehash != REGISTRY_HASH || release.certDescriptor == 0
                || release.memberDescriptor == 0 || release.registryLayout == 0
                || release.executionDescriptor == 0 || release.buildIndex == 0
                || release.primitiveVectors == 0
        ) revert BadBinding();
        GENERATION = FlatBindings.generation(salt, DOMAIN);
    }

    function _identity() internal view override returns (bytes32, bytes32, bytes32) {
        if (
            address(ORDINARY).codehash != ORDINARY_HASH || address(LINEAGE).codehash != LINEAGE_HASH
                || address(RECEIPTS).codehash != RECEIPTS_HASH
                || FlatNative.REGISTRY.codehash != REGISTRY_HASH
        ) {
            revert BadPredecessor();
        }
        return (GENERATION, address(this).codehash, PINS);
    }
}

abstract contract ERC20RecoveryActivation is ERC20RecoveryBinding {
    constructor(ERC20Context.Recovery memory ctx)
        ERC20RecoveryBinding(
            ctx.gamma, ERC20BridgeVerifier(ctx.ordinary), ctx.generation, ctx.release, ctx.pins
        )
    {}
}

