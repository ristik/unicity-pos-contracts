        }
    }

    /// Spec 10.4 for this layout: the buckets are already separate; read, sort each, commit, emit.
    function _sealSparse(uint256 p, uint256 c, uint256 g, uint256 wcur, uint256 wbcur, bool wide) internal {
        uint256 k = K;
        uint256 b = B;
        uint256 logb = LOGB;
        uint256 ev;
        bytes32 hc;
        // The buffer of the other parity becomes current, generation g + 1, empty.
        assembly ("memory-safe") {
            sstore(add(3, xor(p, 1)), or(MARK, add(g, 1)))
            hc := sload(add(1, and(c, 1)))
            ev := mload(0x40)
            mstore(0x40, add(add(ev, 128), shl(5, add(k, b))))
