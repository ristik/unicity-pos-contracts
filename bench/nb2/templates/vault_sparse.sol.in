/// one with the larger generation g = c + 1.
contract @NAME@ {
@PARAMS@
@COMMON@
    uint256 internal constant QMASK = (1 << 192) - 1;
    uint256 internal constant QMAX = (1 << 192) - 1;
    uint256 internal constant MARK = 1 << 255;
    uint256 internal constant M64 = (1 << 64) - 1;

    constructor(bytes memory gamma, address verifier, uint256 k, uint256 b) {
