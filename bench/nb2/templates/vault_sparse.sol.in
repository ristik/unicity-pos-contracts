    /// Count of bucket t in a buffer with words (wa, wb) and generation g.
    function _count(uint256 wa, uint256 wb, uint256 g, uint256 t) internal pure returns (uint256 q) {
        if (t < 16) {
            q = (wa >> (72 + (t << 3))) & 0xff;
        } else if (wb & M64 == g) {
            q = (wb >> (64 + ((t - 16) << 3))) & 0xff;
