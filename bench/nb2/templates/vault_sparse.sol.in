        uint256 k = K;
        uint256 b = B;
        assembly ("memory-safe") {
            sstore(add(add(16, mul(add(mul(p, b), t), k)), qcur), eta)
        }
        wcur += 1 << 64;
        if (wide) {
            if (wbcur & M64 != g) wbcur = g;
            wbcur += 1 << (64 + ((t - 16) << 3));
            assembly ("memory-safe") {
                sstore(add(5, p), wbcur)
