        uint256 z = ev + 128;
        uint256 pos = 0;
        bool ok = true;
        // wbcur is only consulted for buckets 16..31, and it is current whenever wide was set.
        if (!wide && b > 16) {
            assembly ("memory-safe") {
                wbcur := sload(add(5, p))
            }
