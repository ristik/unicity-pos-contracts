        _emitPaid(eta, recipient, amount);
        if ((wcur >> 64) & 0xff == k) {
            if (g + 1 > M64) revert SegmentCounterExhausted();
            _sealSparse(p, c, g, wcur, wbcur, wide);
        }
        _pay(recipient, amount);
        _guardExit();
    }

    function _scanBucket(uint256 p, uint256 t, uint256 q, uint256 eta) internal view {
        uint256 k = K;
        uint256 b = B;
        assembly ("memory-safe") {
            let base := add(16, mul(add(mul(p, b), t), k))
            for { let i := 0 } lt(i, q) { i := add(i, 1) } {
