    /// Spec 10.4: read the K identifiers, distribute by tag, sort each bucket, commit, chain, emit.
    function _sealTags(uint256 p, uint256 c, uint256 eta) internal {
        uint256 tpw = TPW;
        uint256 tw = TW;
        uint256 k = K;
        uint256 logb = LOGB;
        uint256 b = B;
        uint256 ev;
        bytes32 hc;
        bool ok = true;
        assembly ("memory-safe") {
            hc := sload(add(1, and(c, 1)))
            ev := mload(0x40)
            let z := add(ev, 128)
            let cnt := add(z, shl(5, k))
            let bmask := sub(b, 1)
            for { let t := 0 } lt(t, b) { t := add(t, 1) } { mstore(add(cnt, shl(5, t)), 0) }
            let tbase := add(3, mul(p, tw))
            // pass 1: bucket sizes from the tag words
            for { let i := 0 } lt(i, k) {} {
                let word := sload(add(tbase, div(i, tpw)))
                let end := add(i, tpw)
                if gt(end, k) { end := k }
                for {} lt(i, end) { i := add(i, 1) } {
                    let cp := add(cnt, shl(5, and(word, bmask)))
                    mstore(cp, add(mload(cp), 1))
                    word := shr(logb, word)
                }
            }
            // exclusive prefix sums: cnt[t] = start of bucket t
            let run := 0
            for { let t := 0 } lt(t, b) { t := add(t, 1) } {
                let cp := add(cnt, shl(5, t))
                let v := mload(cp)
                mstore(cp, run)
                run := add(run, v)
            }
            // pass 2: scatter identifiers into their buckets, checking each against its tag
            let sbase := add(16, mul(p, k))
            let last := sub(k, 1)
            let sh := sub(256, logb)
            for { let i := 0 } lt(i, k) {} {
                let word := sload(add(tbase, div(i, tpw)))
                let end := add(i, tpw)
                if gt(end, k) { end := k }
                for {} lt(i, end) { i := add(i, 1) } {
                    let t := and(word, bmask)
                    let id := eta
                    if lt(i, last) { id := sload(add(sbase, i)) }
                    if iszero(eq(shr(sh, id), t)) { ok := 0 }
                    let cp := add(cnt, shl(5, t))
                    let pos := mload(cp)
