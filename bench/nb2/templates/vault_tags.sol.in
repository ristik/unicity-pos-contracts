    function _insert(uint256 p, uint256 m, uint256 bucket, uint256 eta) internal {
        uint256 tpw = TPW;
        uint256 tw = TW;
        uint256 k = K;
        uint256 logb = LOGB;
        uint256 bmask = B - 1;
