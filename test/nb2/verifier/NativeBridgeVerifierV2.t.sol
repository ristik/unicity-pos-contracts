pragma solidity 0.8.37;

import {Test} from "forge-std/Test.sol";
import {INativeBridgeVerifierV2} from "../../../src/nb2/INativeBridgeVerifierV2.sol";
import {NativeBridgeVerifierV2} from "../../../src/nb2/verifier/NativeBridgeVerifierV2.sol";
import {Nb2Segment} from "../../../src/nb2/verifier/Nb2Segment.sol";
import {Nb2Crypto} from "../../../src/nb2/verifier/Nb2Crypto.sol";
import {CertBatchDouble, MembershipDouble} from "./Nb2Doubles.sol";
import {Nb2Harness, SealReceiptHarness} from "./Nb2Harness.sol";

/// @notice The token verifier against the shared NB2 vectors (native-bridge-plugins protocol/vectors/nb2, generated by the Go
///         reference bft-core nb2ref, pinned by digest): every verifier vector byte for byte with its on-chain revert, the
///         verifier's Γ vectors, the seal receipts through the same receipt path, the gap/chain/segment-log vectors and the
///         primitives. The 0x0100 and 0x0102 natives are the doubles of Nb2Doubles.sol.
contract NativeBridgeVerifierV2Test is Test {
    string internal constant VECTORS = "test/nb2/vectors/nb2-vectors.json";
    string internal constant TRUST = "test/nb2/verifier/trust.json";
    /// @dev sha256 of the vector file, as pinned upstream (nb2-vectors.json.sha256).
    string internal constant PIN = "test/nb2/vectors/nb2-vectors.json.sha256";

    NativeBridgeVerifierV2 internal production;
    NativeBridgeVerifierV2 internal testBuild;
    SealReceiptHarness internal harnessTest;
    SealReceiptHarness internal harnessProduction;

    function setUp() public {
        vm.etch(address(0x0100), type(CertBatchDouble).runtimeCode);
        vm.etch(address(0x0102), type(MembershipDouble).runtimeCode);
        _loadTrust("main");
        production = new NativeBridgeVerifierV2(false);
        testBuild = new NativeBridgeVerifierV2(true);
        harnessTest = new SealReceiptHarness(true);
        harnessProduction = new SealReceiptHarness(false);
    }

    function _loadTrust(string memory dep) internal {
        string memory t = vm.readFile(TRUST);
        string memory base = string.concat(".", dep);
        CertBatchDouble b = CertBatchDouble(payable(address(0x0100)));
        b.nb2Reset(vm.parseJsonUint(t, string.concat(base, ".network")));
        uint256[] memory epochs = vm.parseJsonUintArray(t, string.concat(base, ".epochs"));
        uint256[] memory starts = vm.parseJsonUintArray(t, string.concat(base, ".starts"));
        uint256[] memory ends = vm.parseJsonUintArray(t, string.concat(base, ".ends"));
        uint256[] memory totals = vm.parseJsonUintArray(t, string.concat(base, ".totals"));
        for (uint256 i; i < epochs.length; ++i) {
            b.nb2Epoch(epochs[i], starts[i], ends[i], totals[i]);
        }
        uint256[] memory me = vm.parseJsonUintArray(t, string.concat(base, ".memberEpochs"));
        bytes[] memory ids = vm.parseJsonBytesArray(t, string.concat(base, ".memberIds"));
        bytes[] memory keys = vm.parseJsonBytesArray(t, string.concat(base, ".memberKeys"));
        uint256[] memory ws = vm.parseJsonUintArray(t, string.concat(base, ".memberWeights"));
        uint256[] memory idx = new uint256[](epochs.length + 8);
        for (uint256 i; i < me.length; ++i) {
            b.nb2Member(me[i], ids[i], keys[i]);
            uint256 slot;
            for (uint256 e; e < epochs.length; ++e) {
                if (epochs[e] == me[i]) slot = e;
            }
            if (ws[i] != 1) b.nb2MemberWeight(me[i], idx[slot], ws[i]);
            ++idx[slot];
        }
    }

    function _k(string memory group, uint256 i, string memory field)
        internal
        pure
        returns (string memory)
    {
        return string.concat(".", group, "[", vm.toString(i), "]", field);
    }

    function _count(string memory j, string memory group) internal view returns (uint256 n) {
        while (vm.keyExistsJson(j, _k(group, n, ".id"))) ++n;
    }

    function _verifierFor(string memory j, string memory dep)
        internal
        view
        returns (NativeBridgeVerifierV2)
    {
        string memory build = vm.parseJsonString(j, string.concat(".deployments.", dep, ".build"));
        return keccak256(bytes(build)) == keccak256("test") ? testBuild : production;
    }

    function _gamma(string memory j, string memory dep) internal pure returns (bytes memory) {
        return vm.parseJsonBytes(j, string.concat(".deployments.", dep, ".gamma"));
    }

    function _call(address v, bytes memory gamma, bytes memory evidence)
        internal
        view
        returns (bool, bytes memory)
    {
        return v.staticcall(abi.encodeCall(INativeBridgeVerifierV2.verifyReturn, (gamma, evidence)));
    }

    function test_vectorDigestPinned() public view {
        bytes memory file = bytes(vm.readFile(VECTORS));
        string memory pin = vm.readFile(PIN);
        assertEq(vm.toString(sha256(file)), string.concat("0x", _firstWord(pin)));
    }

    function _firstWord(string memory s) internal pure returns (string memory) {
        bytes memory b = bytes(s);
        uint256 n;
        while (n < b.length && b[n] != " " && b[n] != "\n") ++n;
        bytes memory out = new bytes(n);
        for (uint256 i; i < n; ++i) {
            out[i] = b[i];
        }
        return string(out);
    }

    /// The shared verdict vectors: every accepted vector returns exactly its 192-byte verdict, every refused one reverts with
    /// exactly its on-chain bytes (onChainError where the rule is wallet-side).
    function test_verifierVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "verifier");
        assertGt(n, 100);
        string memory bad;
        for (uint256 i; i < n; ++i) {
            string memory dep = vm.parseJsonString(j, _k("verifier", i, ".deployment"));
            bytes memory ev = vm.parseJsonBytes(j, _k("verifier", i, ".evidence"));
            bytes memory gamma = vm.keyExistsJson(j, _k("verifier", i, ".gamma"))
                ? vm.parseJsonBytes(j, _k("verifier", i, ".gamma"))
                : _gamma(j, dep);
            (bool ok, bytes memory ret) = _call(address(_verifierFor(j, dep)), gamma, ev);
            bytes memory want;
            bool refuse = vm.keyExistsJson(j, _k("verifier", i, ".expect.revert"));
            if (refuse) {
                want = vm.parseJsonBytes(j, _k("verifier", i, ".expect.revert"));
            } else {
                want = vm.parseJsonBytes(j, _k("verifier", i, ".verdict.abi"));
            }
            if (ok == refuse || keccak256(ret) != keccak256(want)) {
                bad = string.concat(
                    bad, " ", vm.parseJsonString(j, _k("verifier", i, ".id")), "=", vm.toString(ret)
                );
            }
        }
        assertEq(bad, "", "verifier vectors that differ from the Go reference");
    }

    /// The vault's bound on what the verifier may answer: exactly 192 bytes on acceptance; on refusal revert data of at most
    /// 36 bytes (a 4-byte rule, or PrecompileFailed(uint256) / a panic), far below the 1024-byte VerifierRefused limit.
    function test_returnAndRevertSizes() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "verifier");
        uint256 maxRevert;
        for (uint256 i; i < n; ++i) {
            string memory dep = vm.parseJsonString(j, _k("verifier", i, ".deployment"));
            bytes memory gamma = vm.keyExistsJson(j, _k("verifier", i, ".gamma"))
                ? vm.parseJsonBytes(j, _k("verifier", i, ".gamma"))
                : _gamma(j, dep);
            (bool ok, bytes memory ret) = _call(
                address(_verifierFor(j, dep)),
                gamma,
                vm.parseJsonBytes(j, _k("verifier", i, ".evidence"))
            );
            if (ok) assertEq(ret.length, 192, "verdict size");
            else if (ret.length > maxRevert) maxRevert = ret.length;
        }
        assertEq(maxRevert, 4, "every vector refuses with a bare rule selector");
        // the largest error the verifier declares carries one word
        assertEq(abi.encodeWithSelector(Nb2Crypto.PrecompileFailed.selector, uint256(2)).length, 36);
    }

    /// Epoch change between deposit and burn: a deposit certified before and after an authorized EVM validator rotation, every
    /// inclusion proof sealed in root epoch 2, and the same transactions re-certified in epoch 2 (same redemption ID), each UC
    /// judged under its own seal epoch's committee.
    function test_epochChangeBetweenDepositAndBurn() public view {
        string memory j = vm.readFile(VECTORS);
        string[5] memory ids = [
            "ok-deposit-before-rotation",
            "ok-deposit-after-rotation",
            "ok-aggregator-root-epoch-2",
            "ok-refresh-original",
            "ok-refresh-recertified"
        ];
        bytes32[5] memory etas;
        uint256 n = _count(j, "verifier");
        for (uint256 t; t < ids.length; ++t) {
            for (uint256 i; i < n; ++i) {
                if (
                    keccak256(bytes(vm.parseJsonString(j, _k("verifier", i, ".id"))))
                        != keccak256(bytes(ids[t]))
                ) continue;
                (bool ok, bytes memory ret) = _call(
                    address(production),
                    _gamma(j, "main"),
                    vm.parseJsonBytes(j, _k("verifier", i, ".evidence"))
                );
                assertTrue(ok, ids[t]);
                assertEq(
                    keccak256(ret),
                    keccak256(vm.parseJsonBytes(j, _k("verifier", i, ".verdict.abi"))),
                    ids[t]
                );
                (, etas[t]) = abi.decode(ret, (bytes32, bytes32));
            }
        }
        assertEq(etas[3], etas[4], "refreshed certificates keep eta");
    }

    /// Γ as the verifier judges it: ConfigShape for every malformed or unadmitted configuration, before the evidence.
    function test_configVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "config");
        bytes memory ev = vm.parseJsonBytes(j, _k("verifier", 0, ".evidence"));
        string memory bad;
        for (uint256 i; i < n; ++i) {
            string memory dep = vm.parseJsonString(j, _k("config", i, ".deployment"));
            bytes memory gamma = vm.parseJsonBytes(j, _k("config", i, ".gamma"));
            (bool ok, bytes memory ret) = _call(address(_verifierFor(j, dep)), gamma, ev);
            bool refuse = vm.keyExistsJson(j, _k("config", i, ".verifier.revert"));
            if (refuse) {
                bytes memory want = vm.parseJsonBytes(j, _k("config", i, ".verifier.revert"));
                if (ok || keccak256(ret) != keccak256(want)) {
                    bad = string.concat(bad, " ", vm.parseJsonString(j, _k("config", i, ".id")));
                }
            } else if (!ok && bytes4(ret) == bytes4(keccak256("ConfigShape()"))) {
                // an accepted Γ may still refuse the (other deployment's) evidence, but never as ConfigShape
                bad = string.concat(bad, " ", vm.parseJsonString(j, _k("config", i, ".id")));
            }
        }
        assertEq(bad, "", "config vectors");
    }

    /// The wallet's seal receipt check through the verifier's receipt path: the inner rule of every refusal (on chain an
    /// EVM certificate from an epoch the history does not hold is DepositUC, like every EVM-certificate failure).
    function test_sealReceiptVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "sealReceipts");
        string memory bad;
        for (uint256 i; i < n; ++i) {
            if (vm.keyExistsJson(j, _k("sealReceipts", i, ".noReceipt"))) continue;
            string memory dep = vm.parseJsonString(j, _k("sealReceipts", i, ".deployment"));
            bytes memory receipt = vm.parseJsonBytes(j, _k("sealReceipts", i, ".receipt"));
            SealReceiptHarness h = keccak256(
                    bytes(vm.parseJsonString(j, string.concat(".deployments.", dep, ".build")))
                ) == keccak256("test")
                ? harnessTest
                : harnessProduction;
            (bool ok, bytes memory ret) = address(h)
                .staticcall(
                    abi.encodeCall(SealReceiptHarness.verifySealReceipt, (_gamma(j, dep), receipt))
                );
            string memory id = vm.parseJsonString(j, _k("sealReceipts", i, ".id"));
            if (vm.keyExistsJson(j, _k("sealReceipts", i, ".innerRule"))) {
                string memory inner = vm.parseJsonString(j, _k("sealReceipts", i, ".innerRule"));
                if (keccak256(bytes(inner)) == keccak256("NoEntryForEpoch")) inner = "DepositUC";
                if (ok || bytes4(ret) != bytes4(keccak256(bytes(string.concat(inner, "()"))))) {
                    bad = string.concat(bad, " ", id, "=", vm.toString(ret));
                }
            } else {
                (uint64 seg, bytes32 after_) =
                    ok ? abi.decode(ret, (uint64, bytes32)) : (0, bytes32(0));
                if (
                    !ok || seg != vm.parseJsonUint(j, _k("sealReceipts", i, ".result.segment"))
                        || after_
                            != vm.parseJsonBytes32(j, _k("sealReceipts", i, ".result.headAfter"))
                ) bad = string.concat(bad, " ", id, "=", vm.toString(ret));
            }
        }
        assertEq(bad, "", "seal receipt vectors");
    }

    function test_gapProofVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "gapProofs");
        string memory bad;
        for (uint256 i; i < n; ++i) {
            uint256 k = vm.parseJsonUint(j, _k("gapProofs", i, ".K"));
            bytes32 eta = vm.parseJsonBytes32(j, _k("gapProofs", i, ".eta"));
            bytes memory proof = vm.parseJsonBytes(j, _k("gapProofs", i, ".proof"));
            bytes32 root = vm.parseJsonBytes32(j, _k("gapProofs", i, ".root"));
            bytes32[] memory ids = vm.parseJsonBytes32Array(j, _k("gapProofs", i, ".ids"));
            (bool sorted, bytes32 built) = Nb2Segment.root(ids);
            (bool ok, bytes32 m) = Nb2Segment.gapRoot(k, eta, proof);
            bool accept = ok && m == root;
            bool want = !vm.keyExistsJson(j, _k("gapProofs", i, ".expect.error"));
            if (!sorted || built != root || accept != want) {
                bad = string.concat(bad, " ", vm.parseJsonString(j, _k("gapProofs", i, ".id")));
            }
        }
        assertEq(bad, "", "gap proof vectors");
    }

    /// Redeem step 3 (FoldHistory and the stored head), as the vault folds it.
    function test_chainFoldVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "chainFolds");
        string memory bad;
        for (uint256 i; i < n; ++i) {
            bytes memory got = _fold(j, i);
            bytes memory want = vm.keyExistsJson(j, _k("chainFolds", i, ".expect.revert"))
                ? vm.parseJsonBytes(j, _k("chainFolds", i, ".expect.revert"))
                : bytes("");
            if (keccak256(got) != keccak256(want)) {
                bad = string.concat(bad, " ", vm.parseJsonString(j, _k("chainFolds", i, ".id")));
            }
        }
        assertEq(bad, "", "chain fold vectors");
    }

    function _fold(string memory j, uint256 i) internal pure returns (bytes memory) {
        bytes32 d = vm.parseJsonBytes32(j, _k("chainFolds", i, ".domain"));
        uint256 k = vm.parseJsonUint(j, _k("chainFolds", i, ".K"));
        bytes32 eta = vm.parseJsonBytes32(j, _k("chainFolds", i, ".eta"));
        uint256 a = vm.parseJsonUint(j, _k("chainFolds", i, ".a"));
        bytes memory h = vm.parseJsonBytes(j, _k("chainFolds", i, ".history"));
        bytes32 stored = vm.parseJsonBytes32(j, _k("chainFolds", i, ".storedHead"));
        uint256 plen = 65 + 32 * _log2(k);
        bytes32 x;
        assembly ("memory-safe") {
            x := mload(add(h, 32))
        }
        uint256 count = (h.length - 32) / plen;
        for (uint256 p; p < count; ++p) {
            bytes memory proof = new bytes(plen);
            for (uint256 b; b < plen; ++b) {
                proof[b] = h[32 + p * plen + b];
            }
            (bool ok, bytes32 m) = Nb2Segment.gapRoot(k, eta, proof);
            if (!ok) return abi.encodeWithSignature("BadGapProof(uint256)", p);
            x = Nb2Segment.nextHead(d, uint64(a + p), x, m);
        }
        return x == stored ? bytes("") : abi.encodeWithSignature("ChainMismatch()");
    }

    function _log2(uint256 k) internal pure returns (uint256 h) {
        while ((uint256(1) << h) < k) ++h;
    }

    /// The wallet's SegmentSealed log check (CheckSegmentLog).
    function test_segmentLogVectors() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n = _count(j, "segmentLogs");
        string memory bad;
        for (uint256 i; i < n; ++i) {
            bytes32 d = vm.parseJsonBytes32(j, _k("segmentLogs", i, ".domain"));
            uint256 k = vm.parseJsonUint(j, _k("segmentLogs", i, ".K"));
            uint64 seg = uint64(vm.parseJsonUint(j, _k("segmentLogs", i, ".segment")));
            bytes32 before_ = vm.parseJsonBytes32(j, _k("segmentLogs", i, ".expectedHeadBefore"));
            bytes memory data = vm.parseJsonBytes(j, _k("segmentLogs", i, ".data"));
            bool ok = data.length == 128 + 32 * k;
            if (ok) {
                bytes32[] memory z = new bytes32[](k);
                bytes32 w2;
                bytes32 w3;
                bytes32 hb;
                bytes32 ha;
                assembly ("memory-safe") {
                    hb := mload(add(data, 32))
                    ha := mload(add(data, 64))
                    w2 := mload(add(data, 96))
                    w3 := mload(add(data, 128))
                }
                for (uint256 t; t < k; ++t) {
                    bytes32 w;
                    assembly ("memory-safe") {
                        w := mload(add(add(data, 160), mul(32, t)))
                    }
                    z[t] = w;
                }
                (bool sorted, bytes32 m) = Nb2Segment.root(z);
                ok = uint256(w2) == 0x60 && uint256(w3) == 32 * k && sorted && hb == before_
                    && Nb2Segment.nextHead(d, seg, hb, m) == ha;
            }
            bool want = !vm.keyExistsJson(j, _k("segmentLogs", i, ".expect.error"));
            if (ok != want) {
                bad = string.concat(bad, " ", vm.parseJsonString(j, _k("segmentLogs", i, ".id")));
            }
        }
        assertEq(bad, "", "segment log vectors");
    }

    function test_primitives() public view {
        string memory j = vm.readFile(VECTORS);
        uint256 n;
        while (vm.keyExistsJson(
                j, string.concat(".primitives.minterScalars[", vm.toString(n), "].scalar")
            )) ++n;
        for (uint256 i; i < n; ++i) {
            string memory b = string.concat(".primitives.minterScalars[", vm.toString(i), "]");
            uint256 k = uint256(vm.parseJsonBytes32(j, string.concat(b, ".scalar")));
            bool valid = vm.parseJsonBool(j, string.concat(b, ".valid"));
            assertEq(k != 0 && k < Nb2Crypto.N, valid);
            if (valid) {
                assertEq(Nb2Crypto.scalarAddress(k), vm.addr(k), "minter key through ecrecover");
            }
        }
        assertEq(
            Nb2Segment.ARCHIVE_GENESIS,
            vm.parseJsonBytes32(j, ".primitives.constants.ARCHIVE_GENESIS")
        );
        assertEq(
            Nb2Segment.ARCHIVE_STEP, vm.parseJsonBytes32(j, ".primitives.constants.ARCHIVE_STEP")
        );
        assertEq(
            keccak256("UNICITY_NB2_DEPOSIT_SECRET"),
            vm.parseJsonBytes32(j, ".primitives.constants.DEPOSIT_SECRET")
        );
        assertEq(
            sha256("unicity-nb2-asset:native-uct"),
            vm.parseJsonBytes32(j, ".primitives.constants.asset")
        );
        assertEq(INativeBridgeVerifierV2.verifyReturn.selector, bytes4(0xdf447dca)); // the spec's selector
    }

    /// The build is an immutable of the runtime code: a production Γ pins the production code hash, never the test build's.
    function test_buildsHaveDistinctCodeHashes() public view {
        assertTrue(address(production).codehash != address(testBuild).codehash);
        assertTrue(production.admitsTestSet() == false && testBuild.admitsTestSet() == true);
    }

    /// A production verifier refuses a test-set Γ, and a test build refuses the production Γ, before the evidence.
    function test_buildRefusesOtherSet() public view {
        string memory j = vm.readFile(VECTORS);
        bytes memory ev = vm.parseJsonBytes(j, _k("verifier", 0, ".evidence"));
        (bool ok, bytes memory ret) = _call(address(production), _gamma(j, "k4"), ev);
        assertFalse(ok);
        assertEq(bytes4(ret), bytes4(keccak256("ConfigShape()")));
        (ok, ret) = _call(address(testBuild), _gamma(j, "main"), ev);
        assertFalse(ok);
        assertEq(bytes4(ret), bytes4(keccak256("ConfigShape()")));
    }
}
